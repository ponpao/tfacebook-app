# ---------------------------------------------------------------------------
# .env.example — template for Cloud Sync's Firebase credentials.
#
# Copy this file to `.env` (same folder) and fill in real values there.
# `.env` is gitignored and will never be committed — this .example file is
# the only one meant to be checked into source control, and it must never
# contain real secrets.
# ---------------------------------------------------------------------------

# Required: this Firebase project's Storage bucket (e.g. from the Firebase
# Console > Project Settings > General > "Your project" > Storage bucket).
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# --- Service account credentials: use EITHER option A or option B below ---

# Option A (simplest): point at the JSON key file you downloaded from
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Use an absolute path.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: paste the same JSON file's individual fields here instead.
# FIREBASE_PRIVATE_KEY must keep its "\n" line-break escapes exactly as they
# appear in the downloaded JSON (wrap the whole value in double quotes).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
